<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_result"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/bg_bmi_result_card"
    android:elevation="@dimen/card_elevation"
    android:gravity="center_horizontal"
    android:minHeight="@dimen/result_panel_min_height"
    android:orientation="vertical"
    android:padding="@dimen/card_padding">

    <!-- หัวข้อของ Card แสดงผล BMI -->
    <TextView
        android:id="@+id/text_result_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/result_title"
        android:textAlignment="center"
        android:textColor="@color/bmi_text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!--
        แสดงคำแนะนำเริ่มต้นหรือข้อความผิดพลาด
        ResultBinder จะเปลี่ยนข้อความและสีให้ตรงกับสถานะ
    -->
    <TextView
        android:id="@+id/text_result_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/bmi_result_neutral"
        android:textSize="@dimen/text_body"
        tools:text="@string/result_empty" />

    <!--
        แสดงค่า BMI แบบแก้ไขไม่ได้
        BmiTextFormatter จัดรูปแบบให้มีทศนิยม 2 ตำแหน่ง
    -->
    <TextView
        android:id="@+id/text_bmi_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:gravity="center"
        android:textAlignment="center"
        android:textColor="@color/bmi_result_value"
        android:textSize="@dimen/text_bmi_value_size"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="@string/label_bmi"
        tools:visibility="visible" />

    <!--
        แสดงหมวด BMI พร้อมสีตามระดับความเสี่ยง
        ResultBinder กำหนดสีตาม BmiCategory
    -->
    <TextView
        android:id="@+id/text_bmi_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/field_gap"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="@string/category_normal"
        tools:textColor="@color/bmi_normal"
        tools:visibility="visible" />

</LinearLayout>