<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        ชุดสี BMI Compass สำหรับ Dark mode
        ใช้ชื่อเดียวกับโหมดสว่าง Android จึงเลือกสีให้อัตโนมัติ
    -->
    <color name="bmi_canvas">#0F1D1A</color>
    <color name="bmi_surface">#172722</color>
    <color name="bmi_surface_soft">#213832</color>

    <!-- สีหลักปรับให้สว่างขึ้นเพื่ออ่านได้บนพื้นหลังมืด -->
