    <!-- สีเน้นของ Dark mode -->
    <color name="bmi_accent">#FFAB83</color>

    <!-- สีข้อความและเส้นขอบบนพื้นหลังโหมดมืด -->
    <color name="bmi_text_primary">#E6F4EF</color>
    <color name="bmi_text_secondary">#B7CBC4</color>
    <color name="bmi_outline">#49665D</color>

