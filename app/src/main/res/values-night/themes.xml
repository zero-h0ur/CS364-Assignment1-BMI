<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Theme หลักของแอปใน Dark mode
        ใช้ชื่อ Resource เดียวกับโหมดสว่าง แต่ Android จะเลือก
        ค่าสีจาก values-night/colors.xml ให้อัตโนมัติ
    -->
    <style
        name="Base.Theme.BMICalculator"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- สีหลักของปุ่มและองค์ประกอบที่โต้ตอบได้ -->
        <item name="colorPrimary">@color/bmi_primary</item>
        <item name="colorOnPrimary">@color/bmi_on_primary</item>

        <!-- สีของพื้นผิวที่ใช้เน้นบางส่วนของหน้าจอ -->
        <item name="colorPrimaryContainer">@color/bmi_surface_soft</item>
        <item name="colorOnPrimaryContainer">@color/bmi_text_primary</item>

        <!-- สีรองของ BMI Compass -->
        <item name="colorSecondary">@color/bmi_accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- สีพื้นผิว ข้อความ และเส้นขอบ -->
        <item name="colorSurface">@color/bmi_surface</item>
        <item name="colorOnSurface">@color/bmi_text_primary</item>
        <item name="colorOutline">@color/bmi_outline</item>

        <!-- สีพื้นหลังของ Window และ System bars -->
        <item name="android:windowBackground">@color/bmi_canvas</item>
        <item name="android:statusBarColor">@color/bmi_canvas</item>
        <item name="android:navigationBarColor">@color/bmi_canvas</item>

        <!-- ใช้ไอคอนสีอ่อนบน System bars ของ Dark mode -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

    </style>

</resources>